# Bỏ trống PARTNER_API_KEY / HRM_API_KEY / HRM_BASE_URL => chạy chế độ DEMO với dữ liệu giả.

# Partner API của Merchant Job Board (mặc định là UAT)
PARTNER_BASE_URL=https://merchant-job-board-git-uat-mds-think-tank.vercel.app/api/v1/partner
PARTNER_API_KEY=
# Giá trị lọc hồ sơ chưa import. Tài liệu ghi lẫn "new" và "pending" -> kiểm tra trên UAT.
PARTNER_IMPORT_STATUS=new

# Webhook iPOS HRM (do HRM cấp, mỗi môi trường một bộ)
HRM_BASE_URL=
HRM_API_KEY=

# Các tin cần theo dõi: merchantExternalId:jobExternalId, cách nhau bằng dấu phẩy
RELAY_JOBS=

# Đánh dấu imported trên Partner API sau khi HRM nhận hồ sơ (true/false)
RELAY_MARK_IMPORTED=true

# Bắt buộc khi chạy dữ liệu thật: mật khẩu vào dashboard (user tuỳ ý)
DASHBOARD_PASSWORD=
# Vercel tự gửi header Authorization: Bearer <CRON_SECRET> khi gọi cron
CRON_SECRET=
